<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/circular_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_background_rounded"
  android:padding="10dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <LinearLayout
      android:id="@+id/circular_gauge_row_0"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:gravity="center"
      android:orientation="horizontal">

      <ImageView
        android:id="@+id/circular_gauge_0"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_label_2x2"
        android:padding="2dp"
        android:scaleType="fitCenter" />

      <ImageView
        android:id="@+id/circular_gauge_1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_label_2x2"
        android:padding="2dp"
        android:scaleType="fitCenter" />

      <ImageView
        android:id="@+id/circular_gauge_2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_label_2x2"
        android:padding="2dp"
        android:scaleType="fitCenter" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/circular_gauge_row_1"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:gravity="center"
      android:orientation="horizontal">

      <ImageView
        android:id="@+id/circular_gauge_3"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_label_2x2"
        android:padding="2dp"
        android:scaleType="fitCenter" />

      <ImageView
        android:id="@+id/circular_gauge_4"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_label_2x2"
        android:padding="2dp"
        android:scaleType="fitCenter" />

      <ImageView
        android:id="@+id/circular_gauge_5"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_label_2x2"
        android:padding="2dp"
        android:scaleType="fitCenter" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/circular_gauge_row_2"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:gravity="center"
      android:orientation="horizontal">

      <ImageView
        android:id="@+id/circular_gauge_6"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_label_2x2"
        android:padding="2dp"
        android:scaleType="fitCenter" />

      <ImageView
        android:id="@+id/circular_gauge_7"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_label_2x2"
        android:padding="2dp"
        android:scaleType="fitCenter" />

      <ImageView
        android:id="@+id/circular_gauge_8"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_label_2x2"
        android:padding="2dp"
        android:scaleType="fitCenter" />
    </LinearLayout>
  </LinearLayout>

  <TextView
    android:id="@+id/circular_login_message"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:padding="12dp"
    android:text="@string/widget_sign_in_required"
    android:textColor="@color/widget_caption"
    android:textSize="12sp"
    android:textStyle="bold"
    android:visibility="visible" />

  <ImageButton
    android:id="@+id/circular_refresh_button"
    android:layout_width="32dp"
    android:layout_height="32dp"
    android:layout_gravity="top|end"
    android:background="@android:color/transparent"
    android:contentDescription="@string/widget_refresh"
    android:padding="7dp"
    android:src="@drawable/ic_refresh" />

  <ImageView
    android:id="@+id/circular_refresh_progress"
    android:layout_width="32dp"
    android:layout_height="32dp"
    android:layout_gravity="top|end"
    android:contentDescription="@string/widget_refresh"
    android:padding="7dp"
    android:src="@drawable/widget_refresh_spinner_dots"
    android:visibility="gone" />
</FrameLayout>
