<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:paddingStart="12dp"
  android:paddingTop="3dp"
  android:paddingEnd="12dp"
  android:paddingBottom="3dp">

  <TextView
    android:id="@+id/notification_compact_summary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:includeFontPadding="false"
    android:lineSpacingExtra="1dp"
    android:maxLines="2"
    android:text="No active usage limits"
    android:textColor="#111827"
    android:textSize="13sp"
    android:visibility="gone" />

  <LinearLayout
    android:id="@+id/notification_compact_grid"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
      android:id="@+id/notification_compact_row_0"
      android:layout_width="match_parent"
      android:layout_height="20dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <LinearLayout
        android:id="@+id/notification_compact_item_0"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
          android:id="@+id/notification_compact_icon_0"
          android:layout_width="15dp"
          android:layout_height="15dp"
          android:contentDescription="@null" />

        <TextView
          android:id="@+id/notification_compact_text_0"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="5dp"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="100%"
          android:textColor="#111827"
          android:textSize="12sp" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/notification_compact_item_1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
          android:id="@+id/notification_compact_icon_1"
          android:layout_width="15dp"
          android:layout_height="15dp"
          android:contentDescription="@null" />

        <TextView
          android:id="@+id/notification_compact_text_1"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="5dp"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="69%"
          android:textColor="#111827"
          android:textSize="12sp" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/notification_compact_item_2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
          android:id="@+id/notification_compact_icon_2"
          android:layout_width="15dp"
          android:layout_height="15dp"
          android:contentDescription="@null" />

        <TextView
          android:id="@+id/notification_compact_text_2"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="5dp"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="100%"
          android:textColor="#111827"
          android:textSize="12sp" />
      </LinearLayout>
    </LinearLayout>

    <LinearLayout
      android:id="@+id/notification_compact_row_1"
      android:layout_width="match_parent"
      android:layout_height="20dp"
      android:layout_marginTop="1dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <LinearLayout
        android:id="@+id/notification_compact_item_3"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
          android:id="@+id/notification_compact_icon_3"
          android:layout_width="15dp"
          android:layout_height="15dp"
          android:contentDescription="@null" />

        <TextView
          android:id="@+id/notification_compact_text_3"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="5dp"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="100%"
          android:textColor="#111827"
          android:textSize="12sp" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/notification_compact_item_4"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
          android:id="@+id/notification_compact_icon_4"
          android:layout_width="15dp"
          android:layout_height="15dp"
          android:contentDescription="@null" />

        <TextView
          android:id="@+id/notification_compact_text_4"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="5dp"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="99%"
          android:textColor="#111827"
          android:textSize="12sp" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/notification_compact_item_5"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
          android:id="@+id/notification_compact_icon_5"
          android:layout_width="15dp"
          android:layout_height="15dp"
          android:contentDescription="@null" />

        <TextView
          android:id="@+id/notification_compact_text_5"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="5dp"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="17%"
          android:textColor="#111827"
          android:textSize="12sp" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
