<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_background_rounded"
  android:gravity="center"
  android:orientation="vertical"
  android:padding="10dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:layout_width="16dp"
      android:layout_height="16dp"
      android:contentDescription="@string/widget_label_3x2"
      android:src="@drawable/ic_provider_claude" />

    <FrameLayout
      android:layout_width="0dp"
      android:layout_height="7dp"
      android:layout_marginStart="8dp"
      android:layout_weight="1"
      android:background="@drawable/widget_preview_bar_track">

      <TextView
        android:layout_width="120dp"
        android:layout_height="match_parent"
        android:background="@drawable/widget_preview_bar_fill"
        android:text="" />
    </FrameLayout>
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:layout_width="16dp"
      android:layout_height="16dp"
      android:contentDescription="@string/widget_label_3x2"
      android:src="@drawable/ic_provider_openai" />

    <FrameLayout
      android:layout_width="0dp"
      android:layout_height="7dp"
      android:layout_marginStart="8dp"
      android:layout_weight="1"
      android:background="@drawable/widget_preview_bar_track">

      <TextView
        android:layout_width="96dp"
        android:layout_height="match_parent"
        android:background="@drawable/widget_preview_bar_fill"
        android:text="" />
    </FrameLayout>
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:layout_width="16dp"
      android:layout_height="16dp"
      android:contentDescription="@string/widget_label_3x2"
      android:src="@drawable/ic_provider_gemini" />

    <FrameLayout
      android:layout_width="0dp"
      android:layout_height="7dp"
      android:layout_marginStart="8dp"
      android:layout_weight="1"
      android:background="@drawable/widget_preview_bar_track">

      <TextView
        android:layout_width="132dp"
        android:layout_height="match_parent"
        android:background="@drawable/widget_preview_bar_fill"
        android:text="" />
    </FrameLayout>
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:layout_width="16dp"
      android:layout_height="16dp"
      android:contentDescription="@string/widget_label_3x2"
      android:src="@drawable/ic_provider_copilot" />

    <FrameLayout
      android:layout_width="0dp"
      android:layout_height="7dp"
      android:layout_marginStart="8dp"
      android:layout_weight="1"
      android:background="@drawable/widget_preview_bar_track">

      <TextView
        android:layout_width="108dp"
        android:layout_height="match_parent"
        android:background="@drawable/widget_preview_bar_fill"
        android:text="" />
    </FrameLayout>
  </LinearLayout>
</LinearLayout>
