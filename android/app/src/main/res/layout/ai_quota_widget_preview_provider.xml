<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_background_macos_rounded"
  android:gravity="center_vertical"
  android:orientation="vertical"
  android:paddingStart="10dp"
  android:paddingTop="6dp"
  android:paddingEnd="10dp"
  android:paddingBottom="6dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="22dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:layout_width="18dp"
      android:layout_height="18dp"
      android:contentDescription="Claude"
      android:src="@drawable/ic_provider_claude" />

    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="7dp"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="Claude"
      android:textColor="#141413"
      android:textSize="12sp" />

    <ImageView
      android:layout_width="20dp"
      android:layout_height="20dp"
      android:contentDescription="@string/widget_refresh"
      android:src="@drawable/ic_refresh" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:orientation="vertical">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="15dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="5시간 세션"
        android:textColor="#3D3D3A"
        android:textSize="9sp" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="1dp"
        android:text="60% 남음"
        android:textColor="#3D3D3A"
        android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="5dp"
      android:layout_marginTop="3dp"
      android:background="@drawable/widget_preview_bar_track"
      android:orientation="horizontal">

      <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="60"
        android:background="@drawable/widget_preview_bar_fill" />

      <Space
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="40" />
    </LinearLayout>

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="1dp"
      android:ellipsize="end"
      android:gravity="end"
      android:maxLines="1"
      android:text="2시간 9분 후 초기화"
      android:textColor="#6C6A64"
      android:textSize="8sp" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:orientation="vertical">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="15dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="주간 세션"
        android:textColor="#3D3D3A"
        android:textSize="9sp" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="1dp"
        android:text="89% 남음"
        android:textColor="#3D3D3A"
        android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="5dp"
      android:layout_marginTop="3dp"
      android:background="@drawable/widget_preview_bar_track"
      android:orientation="horizontal">

      <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="89"
        android:background="@drawable/widget_preview_bar_fill" />

      <Space
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="11" />
    </LinearLayout>

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="1dp"
      android:ellipsize="end"
      android:gravity="end"
      android:maxLines="1"
      android:text="6일 11시간 후 초기화"
      android:textColor="#6C6A64"
      android:textSize="8sp" />
  </LinearLayout>
</LinearLayout>
